{
  "name": "@xindong/dsh-canvas",
  "version": "0.1.1",
  "description": "UI-neutral persistent canvas service and Agent tools for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "es-module-lexer": "3.0.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2 <0.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xindong/dsh-canvas.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/xindong/dsh-canvas/issues"
  },
  "homepage": "https://github.com/xindong/dsh-canvas#readme",
  "keywords": [
    "deepseek-harness",
    "canvas",
    "agent",
    "pixiboardjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
